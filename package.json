{
  "name": "paperless-mcp-server",
  "version": "3.2.0",
  "description": "MCP server for Paperless-ngx: search (keyword and semantic), read, file and annotate documents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "paperless-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justmytwospence/paperless-mcp.git"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.0",
    "hono": "^4.13.13",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
